# Copy to prod.env (never commit the copy) and fill in. Every value here is a placeholder, and the
# hosts refuse the placeholder values by name: a deployment that copied this file and stopped gets
# a refusal at startup naming the setting, rather than a running site whose secrets are published in
# this repository.
POSTGRES_USER=rma_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rmaprod
RMA_WEB_HOST=returns.example.com
RMA_MCP_HOST=mcp.example.com
ACME_EMAIL=ops@example.com
RMA_OPERATIONS_KEY=replace-with-a-long-random-key
OIDC_AUTHORITY=https://idp.example.com/realms/rma
OIDC_OPERATOR_CLIENT_ID=rma-operator
OIDC_OPERATOR_CLIENT_SECRET=replace-me
MCP_CLIENT_ID=support-agent
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
RAG_ADMIN_KEY=replace-with-a-long-random-key
# Database backups (scripts/backup.sh, run nightly by deploy/rma-backup.timer). BACKUP_REMOTE is an
# rclone destination OUTSIDE this host -- object storage, a remote host, or a mounted disk:
# BACKUP_REMOTE=s3:rma-prod-backups/postgres
# BACKUP_REMOTE=sftp:backup.example.com:/srv/rma
# BACKUP_REMOTE=local:/mnt/offsite/rma
# Its credentials live in rclone.conf under RCLONE_CONFIG_DIR (default /etc/aienabledrma), never in
# this file. Browsers, SFTP and S3 all keep working through rclone, so no storage key belongs here.
# BACKUP_REMOTE=replace-with-a-destination-outside-this-host
# How many days of dumps to keep, on the destination and in the staging directory.
# BACKUP_KEEP_DAYS=14
# The dumps are encrypted before they are uploaded. The passphrase is a file beside rclone.conf
# (RCLONE_CONFIG_DIR/backup.passphrase), not a value here: prod.env is copied into every container,
# and the key must not travel with the objects it opens.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://llm.internal.example.com/v1
# RAG_VECTOR_STORE=true
# Embeddings (D4): local Ollama by default (EMBEDDINGS_BASE_URL=http://ollama:11434, nomic-embed-text, 768).
# EMBEDDINGS_MODEL=bge-m3
# EMBEDDINGS_DIMENSIONS=1024
# Hosted instead:
# EMBEDDINGS_PROVIDER=openai-compatible
# EMBEDDINGS_BASE_URL=https://embeddings.example.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1536
# EMBEDDINGS_API_KEY=replace-me
