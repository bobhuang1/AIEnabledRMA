@{
    var errors = ViewData.ModelState;
    if (errors is null || errors.ErrorCount == 0)
    {
        return;
    }
}

<div class="alert alert-error" role="alert">
    <h2 class="alert-title">There is a problem</h2>
    <ul>
        @foreach (var error in errors.Values.SelectMany(e => e.Errors))
        {
            <li>@error.ErrorMessage</li>
        }
    </ul>
</div>
