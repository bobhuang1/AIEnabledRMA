{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Rma": "Host=localhost;Port=5432;Database=rmadev;Username=rmauser;Password=placeholder"
  },
  "Ai": {
    "Provider": "example-local",
    "BaseUrl": "",
    "TimeoutSeconds": 30
  },
  "Rag": {
    "KnowledgeBasePath": "knowledge-base",
    "TopK": 3,
    "EnabledProductFamilies": []
  },
  "OperatorAuth": {
    "Authority": "",
    "ClientId": "",
    "RequiredRole": "rma:operator",
    "DevSignIn": false
  },
  "Rag:VectorStore": {
    "Enabled": false
  },
  "Embeddings": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "Dimensions": 768
  },
  "Rag:Retrieval": {
    "TermFrequencyWeight": 1.0,
    "CoverageWeight": 1.0,
    "CategoryHintBoost": 0.25,
    "MaxRelatedExpansions": 2,
    "RelatedArticleFloor": 0.05
  },
  "Triage": {
    "RetrievalTopK": 6,
    "MaxSteps": 6,
    "MaxStepLength": 300,
    "MaxSummaryLength": 600,
    "MaxConversationTurnsSent": 12,
    "Temperature": 0.1,
    "MaxOutputTokens": 900,
    "ScopeGuard": {
      "MinimumTopicTokenRatio": 0.2,
      "CustomerTurnsToConsider": 3,
      "TopicVocabularies": [
        [ "power", "charge", "charging", "charger", "battery", "light", "indicator", "led", "blinking", "flashing", "flashes", "amber", "green", "orange", "red", "cradle", "dock", "docks", "turn", "dead", "boot", "start", "shutdown", "reset", "adapter", "supply", "plug", "outlet", "fuse" ],
        [ "screen", "display", "blank", "black", "dim", "backlight", "image", "lcd", "touch", "flicker", "flickers" ],
        [ "bluetooth", "pair", "pairing", "paired", "wireless", "wifi", "radio", "range", "signal", "connection", "connect", "disconnect", "disconnecting", "drops", "host", "software", "driver", "detect", "detected", "computer", "usb" ],
        [ "scan", "scanner", "scanning", "trigger", "barcode", "label", "laser", "imager", "lens", "window", "read", "reads", "decode", "beam", "beams" ],
        [ "dropped", "drop", "fell", "impact", "cracked", "crack", "broken", "damage", "damaged", "scratched", "water", "liquid", "wet", "spill", "spilled", "moisture", "rain" ],
        [ "firmware", "update", "upgrade", "bricked", "reboot", "reboots", "rebooting", "restart", "restarts", "restarting", "freeze", "freezes", "frozen", "crash", "loop", "error", "fault", "faulty" ],
        [ "unit", "device", "handset", "terminal", "button", "cable", "holster", "strap", "mount", "accessory", "working", "stopped", "broke", "won", "wont", "doesn", "nothing", "repair", "return", "warranty", "evidence", "hardware", "confirm", "genuine", "rma" ]
      ],
      "DenyPhrases": [ "write me a poem", "write a poem", "tell me a joke", "capital of", "ignore previous instructions", "ignore all previous" ]
    }
  },
  "DeviceLookup": {
    "AllowFuzzyMatch": true,
    "MinimumMatchScore": 0.72,
    "FuzzyCandidatePoolSize": 25,
    "AllowFullScanFallback": true
  },
  "CustomerLookup": {
    "MinimumMatchScore": 0.55,
    "CandidatePoolSize": 50,
    "AllowFullScanFallback": true,
    "FullScanThreshold": 5000
  },
  "RmaPolicy": {
    "AiIsAdvisoryOnly": true,
    "FallbackEligibility": "RequiresHumanReview",
    "FallbackReason": "LowConfidenceTriage",
    "GracePeriodDays": 30,
    "ReturnWindowDays": 730,
    "MinimumAutoApproveConfidence": 0.75,
    "HumanReviewConfidenceThreshold": 0.45,
    "DefaultTier": "standard",
    "DefaultRepairFee": 99.00,
    "RepairPrices": [
      {
        "Sku": "AX-200-HS",
        "RepairFee": 69.00
      },
      {
        "Sku": "AX-400-RG",
        "RepairFee": 119.00
      },
      {
        "Sku": "BX-100-KT",
        "RepairFee": 149.00
      },
      {
        "Sku": "CR-10-CRD",
        "RepairFee": 29.00
      },
      {
        "Sku": "CBL-USB-3M",
        "RepairFee": 9.00
      }
    ],
    "Tiers": [
      {
        "Name": "standard",
        "TurnaroundBusinessDays": 10,
        "ReplacementTier": "standard",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "extended",
        "TurnaroundBusinessDays": 5,
        "ReplacementTier": "standard",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "premium",
        "TurnaroundBusinessDays": 2,
        "ReplacementTier": "premium",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "no-service",
        "TurnaroundBusinessDays": 21,
        "ReplacementTier": "standard",
        "IsCovered": false,
        "CurrencyCode": "USD"
      }
    ],
    "ExcludedCauses": [
      {
        "RuleId": "cause.liquid",
        "Description": "Liquid ingress is not covered under any warranty tier.",
        "Terms": [ "liquid", "water", "spilled", "soaked", "wet", "dunked", "rain" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      },
      {
        "RuleId": "cause.impact",
        "Description": "Physical impact damage is not covered unless a tier explicitly includes it.",
        "Terms": [ "dropped", "fell", "drop", "smashed", "cracked", "kicked", "thrown" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      },
      {
        "RuleId": "cause.cosmetic",
        "Description": "Cosmetic wear is a paid repair, not a warranty claim.",
        "Terms": [ "scratched", "scuffed", "cosmetic", "worn", "chipped" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      }
    ],
    "HumanReviewOnlyRegions": [],
    "FraudIndicatorSerialPrefixes": [ "SUSPECT", "TESTFRAUD" ]
  }
}
