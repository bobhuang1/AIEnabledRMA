<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AIEnabledRma.Web</RootNamespace>
    <AssemblyName>AIEnabledRma.Web</AssemblyName>
    <UserSecretsId>aienabledrma-web</UserSecretsId>
    <!-- The .NET 11 SDK adds a Blazor hot-reload JS module to every Debug web build. This MVC app has
         no endpoint for it, so the build fails with "scoped css bundles do not have matching endpoints".
         The site does not use browser hot reload, so it is switched off. -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIEnabledRma.Domain\AIEnabledRma.Domain.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Data\AIEnabledRma.Data.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Ai\AIEnabledRma.Ai.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Privacy\AIEnabledRma.Privacy.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Rag\AIEnabledRma.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

</Project>
