<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AIEnabledRma.Web</RootNamespace>
    <AssemblyName>AIEnabledRma.Web</AssemblyName>
    <UserSecretsId>aienabledrma-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIEnabledRma.Domain\AIEnabledRma.Domain.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Data\AIEnabledRma.Data.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Ai\AIEnabledRma.Ai.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Rag\AIEnabledRma.Rag.csproj" />
  </ItemGroup>

  <!-- The knowledge corpus ships with the site. A deployment that forgot to copy it would
       otherwise start cleanly and then treat every question as "no evidence", which reads as
       a working assistant that happens to know nothing. -->
  <ItemGroup>
    <None Include="..\..\knowledge-base\**\*.md"
          Link="knowledge-base\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
