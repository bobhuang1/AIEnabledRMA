<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AIEnabledRma.Mcp</RootNamespace>
    <AssemblyName>AIEnabledRma.Mcp</AssemblyName>
    <UserSecretsId>aienabledrma-mcp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting and console logging (stdio mode logs to stderr so stdout stays a clean
         JSON-RPC channel) come from the Microsoft.AspNetCore.App framework reference below,
         which HTTP mode needs anyway. -->
    <PackageReference Include="ModelContextProtocol" />
    <!-- HTTP mode (McpHttpHost): streamable HTTP transport behind JWT bearer authentication. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied so the host can read the connection string and the policy configuration.
         The values here are the local docker-compose development credentials; a real
         deployment overrides them with the ConnectionStrings__Rma environment variable
         and never ships a production password in a file. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIEnabledRma.Domain\AIEnabledRma.Domain.csproj" />
    <ProjectReference Include="..\AIEnabledRma.Data\AIEnabledRma.Data.csproj" />
  </ItemGroup>

</Project>
