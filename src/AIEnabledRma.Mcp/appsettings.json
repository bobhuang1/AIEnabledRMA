{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ModelContextProtocol": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Rma": "Host=localhost;Port=5432;Database=rmadev;Username=rmauser;Password=rmapassword"
  },
  "DeviceLookup": {
    "AllowFuzzyMatch": true,
    "MinimumMatchScore": 0.72,
    "FuzzyCandidatePoolSize": 25,
    "AllowFullScanFallback": true
  },
  "CustomerLookup": {
    "MinimumMatchScore": 0.55,
    "CandidatePoolSize": 50,
    "AllowFullScanFallback": true,
    "FullScanThreshold": 5000
  },
  "RmaPolicy": {
    "AiIsAdvisoryOnly": true,
    "FallbackEligibility": "RequiresHumanReview",
    "FallbackReason": "LowConfidenceTriage",
    "GracePeriodDays": 30,
    "ReturnWindowDays": 730,
    "MinimumAutoApproveConfidence": 0.75,
    "HumanReviewConfidenceThreshold": 0.45,
    "DefaultTier": "standard",
    "DefaultRepairFee": 99.00,
    "RepairPrices": [
      {
        "Sku": "AX-200-HS",
        "RepairFee": 69.00
      },
      {
        "Sku": "AX-400-RG",
        "RepairFee": 119.00
      },
      {
        "Sku": "BX-100-KT",
        "RepairFee": 149.00
      },
      {
        "Sku": "CR-10-CRD",
        "RepairFee": 29.00
      },
      {
        "Sku": "CBL-USB-3M",
        "RepairFee": 9.00
      }
    ],
    "Tiers": [
      {
        "Name": "standard",
        "TurnaroundBusinessDays": 10,
        "ReplacementTier": "standard",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "extended",
        "TurnaroundBusinessDays": 5,
        "ReplacementTier": "standard",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "premium",
        "TurnaroundBusinessDays": 2,
        "ReplacementTier": "premium",
        "IsCovered": true,
        "CurrencyCode": "USD"
      },
      {
        "Name": "no-service",
        "TurnaroundBusinessDays": 21,
        "ReplacementTier": "standard",
        "IsCovered": false,
        "CurrencyCode": "USD"
      }
    ],
    "ExcludedCauses": [
      {
        "RuleId": "cause.liquid",
        "Description": "Liquid ingress is not covered under any warranty tier.",
        "Terms": [ "liquid", "water", "spilled", "soaked", "wet", "dunked", "rain" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      },
      {
        "RuleId": "cause.impact",
        "Description": "Physical impact damage is not covered unless a tier explicitly includes it.",
        "Terms": [ "dropped", "fell", "drop", "smashed", "cracked", "kicked", "thrown" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      },
      {
        "RuleId": "cause.cosmetic",
        "Description": "Cosmetic wear is a paid repair, not a warranty claim.",
        "Terms": [ "scratched", "scuffed", "cosmetic", "worn", "chipped" ],
        "MatchMode": "AnyTerm",
        "ResultingEligibility": "NotEligible",
        "ResultingReason": "ExcludedCause",
        "IsActive": true
      }
    ],
    "HumanReviewOnlyRegions": [],
    "FraudIndicatorSerialPrefixes": [ "SUSPECT", "TESTFRAUD" ]
  }
}
